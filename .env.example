# Copy to .env.local and fill in. Each provider is enabled by its variables.

# Postgres provider (drizzle-orm + postgres.js). Run `pnpm db:migrate` once.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/file_upload

# ImageKit provider. Private key: ImageKit dashboard → Developer options.
IMAGEKIT_PRIVATE_KEY=
# The folder this app owns inside your ImageKit media library.
IMAGEKIT_FOLDER=/file-upload

# Optional limits.
# FILE_UPLOAD_MAX_BYTES=25000000
# FILE_UPLOAD_ALLOWED_TYPES=image/*,application/pdf,text/plain

# Only for `pnpm test`: a DISPOSABLE database (the suite drops the file_upload schema).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/file_upload_test
